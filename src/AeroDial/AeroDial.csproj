<Project Sdk="Microsoft.NET.Sdk">

  <!-- Release settings ───────────────────────────────────────────────────
       Trimming is intentionally DISABLED. AeroDial relies on reflection-based
       System.Text.Json (config, themes, menus) and built-in COM (AudioService's
       WASAPI volume access) — trimming turns on feature switches that disable
       both (JsonSerializerIsReflectionEnabledByDefault=false, BuiltInComInterop
       IsSupported=false), which breaks config load/save and audio at runtime.

       Single-file: `dotnet publish -c Release -r win-x64` produces ONE self-
       contained AeroDial.exe. The WinUI 3 / SkiaSharp native DLLs are bundled
       and self-extracted at runtime (IncludeNativeLibrariesForSelfExtract).
       EnableMsixTooling=true (main group) is required by the Windows App SDK to
       embed resources.pri in single-file mode. The 11 built-in themes live in
       code (BuiltInThemes.cs), so no external themes/ folder is needed.       -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>AeroDial</RootNamespace>
    <ApplicationIcon>Assets\aerodial.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Required by the Windows App SDK for single-file publish (resources.pri embed).
         App stays unpackaged (WindowsPackageType=None). -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <DisableMsvcVersionCheck>true</DisableMsvcVersionCheck>
    <!-- Self-contained: bundles WinUI native DLLs, no runtime registration needed -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- Suppress auto-generated Program/Main so ours is used -->
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>AeroDial</AssemblyName>
    <Version>2.0.0</Version>
    <Company>3M Design Solutions</Company>
    <Authors>Muhtasim Mahbub</Authors>
    <Copyright>Copyright © 2026 Muhtasim Mahbub | 3M Design Solutions</Copyright>
    <Description>AeroDial — A radial launcher overlay for Windows</Description>
    <Optimize Condition="'$(Configuration)'=='Release'">true</Optimize>
    <!-- Strip satellite assemblies for all languages except English.
         Removes zh-TW, ur-PK, fr-FR, etc. from publish output (~30-50 MB saved). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.Views.WinUI" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.88.8" />
  </ItemGroup>

  <ItemGroup>
    <None Update="themes\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>


</Project>
